# -----------------------------------------------------------------------------
# FRAME — переменные окружения
# Скопируйте файл в .env.local и заполните значения.
# -----------------------------------------------------------------------------

# Адрес проекта Supabase.
#   Облако: Supabase Dashboard → Project Settings → API → Project URL
#   Локально: вывод команды `npx supabase start` (API URL); укажите http://localhost:54321 —
#   этот адрес задан в supabase/config.toml ([api] external_url) и нужен для входа MCP-клиентов
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Публичный ключ (anon / publishable). Безопасен для браузера: доступ ограничен RLS.
#   Облако: Project Settings → API Keys → anon public (или Publishable key)
#   Локально: вывод `npx supabase start` (anon key / Publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key / Publishable key>

# Публичный адрес сайта — используется в ссылках из писем (подтверждение почты,
# восстановление пароля). Должен совпадать с Site URL в настройках Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Сервисный ключ (service_role) приложению НЕ нужен и не должен сюда попадать:
# все операции выполняются от имени пользователя и проверяются политиками RLS.
# Он используется только скриптом `npm run make-admin` и только локально,
# через переменную окружения при запуске (см. README).

# -----------------------------------------------------------------------------
# Примерочная и ассистент на сайте — OpenAI (ChatGPT API). Ключ используется только
# на сервере: https://platform.openai.com/api-keys (не публикуйте и не пересылайте).
# API оплачивается отдельно от подписки ChatGPT. Без ключа загрузка моделей и нарядов
# работает, а кнопка «Примерить» и ассистент отключены.
OPENAI_API_KEY=
# Необязательно: адрес шлюза, совместимого с OpenAI (Base URL со страницы шлюза),
# вместо https://api.openai.com/v1. Ключ тогда — ключ этого шлюза.
# OPENAI_BASE_URL=
# Необязательно: модель примерочной (по умолчанию gpt-image-1) и качество
# low | medium | high | auto (по умолчанию medium: high заметно дольше и дороже).
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium

# Только для разработки и e2e-тестов без ключа: вместо генерации возвращается
# исходное фото модели. В production игнорируется.
# TRYON_PROVIDER=mock

# Только для локальной разработки: https-адрес страницы входа для MCP-клиентов.
# Приложение Claude открывает вход только по https — запустите `npm run dev:oauth-https`
# и раскомментируйте строку (см. README, «MCP-сервер и OAuth»). В облаке не задавайте.
# MCP_OAUTH_AUTHORIZE_URL=https://localhost:3001/authorize

# -----------------------------------------------------------------------------
# Ассистент FRAME на сайте (кнопка в углу для вошедших пользователей) — тоже OpenAI,
# ключ OPENAI_API_KEY (см. выше). Лимит: 40 сообщений в сутки на пользователя (в базе);
# сообщение засчитывается только после успешного ответа модели.
# Необязательно: модель (по умолчанию gpt-5-mini) и reasoning_effort
# minimal | low | medium | high (только для моделей с рассуждениями).
# ASSISTANT_MODEL=gpt-5-mini
# ASSISTANT_REASONING=low
